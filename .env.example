# ─────────────────────────────────────────────────────────────
# AushadX – environment variables for Docker Compose
# Copy this file to .env and fill in your real values.
# ⚠  Rotate ALL secrets before deploying to production.
# ─────────────────────────────────────────────────────────────

# JWT secrets (profile-manager / api-server)
JWT_SECRET=aushadx-secret-key-2026-change-in-production
JWT_ACCESS_SECRET=aushadx-access-secret-2026-change-in-production
JWT_REFRESH_SECRET=aushadx-refresh-secret-2026-change-in-production

# LLM provider (gemini | openai)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash


# Google / Gemini API key  (medicine-analyzer + agent-service both use this)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (optional – only needed when LLM_PROVIDER=openai)
```dotenv
OPENAI_API_KEY=your_openai_api_key_here
```

# Pinecone (medicine-analyzer)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=medicine-knowledgebase
PINECONE_INDEX_HOST=your_pinecone_index_host_url
PINECONE_NAMESPACE=medicine_kb_v1

# Logging
LOG_LEVEL=info
