# ============================================================
# AushadX – Kubernetes Manifests for Minikube
# Services: mongodb, api-server, profile-manager,
#            medicine-analyzer, medicine-scheduler, agent-service
#
# MongoDB runs as a StatefulSet with a 5 Gi PVC.
# Inter-service URLs are built using Kubernetes $(VAR_NAME)
# variable expansion. Change the _HOST / _PORT vars and the
# composed *_URL values are updated automatically.
# ============================================================

---
# ─── Namespace ───────────────────────────────────────────────
apiVersion: v1
kind: Namespace
metadata:
  name: aushadx

---
# ─── Secrets (fill in real values before applying) ───────────
apiVersion: v1
kind: Secret
metadata:
  name: aushadx-secrets
  namespace: aushadx
type: Opaque
stringData:
  MONGO_URI: "mongodb://mongodb.aushadx.svc.cluster.local:27017/aushadx"
  JWT_SECRET: "CHANGE_ME_strong_jwt_secret"
  JWT_ACCESS_SECRET: "CHANGE_ME_access_secret"
  JWT_REFRESH_SECRET: "CHANGE_ME_refresh_secret"
  GEMINI_API_KEY: "YOUR_GEMINI_API_KEY"
  OPENAI_API_KEY: "YOUR_OPENAI_API_KEY"
  PINECONE_API_KEY: "YOUR_PINECONE_API_KEY"
  PINECONE_INDEX: "YOUR_PINECONE_INDEX"
  PINECONE_INDEX_HOST: "YOUR_PINECONE_INDEX_HOST"
  PINECONE_NAMESPACE: "medicine"

---
# ════════════════════════════════════════════════════════════
# MongoDB – StatefulSet, PVC, Service
# ════════════════════════════════════════════════════════════
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: mongodb-pvc
  namespace: aushadx
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 5Gi

---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: mongodb
  namespace: aushadx
spec:
  serviceName: mongodb
  replicas: 1
  selector:
    matchLabels:
      app: mongodb
  template:
    metadata:
      labels:
        app: mongodb
    spec:
      containers:
        - name: mongodb
          image: mongo:7
          ports:
            - containerPort: 27017
          env:
            - name: MONGO_INITDB_DATABASE
              value: aushadx
          volumeMounts:
            - name: mongodb-data
              mountPath: /data/db
          readinessProbe:
            exec:
              command:
                - mongosh
                - --eval
                - "db.adminCommand('ping')"
            initialDelaySeconds: 15
            periodSeconds: 10
          livenessProbe:
            exec:
              command:
                - mongosh
                - --eval
                - "db.adminCommand('ping')"
            initialDelaySeconds: 30
            periodSeconds: 15
      volumes:
        - name: mongodb-data
          persistentVolumeClaim:
            claimName: mongodb-pvc

---
apiVersion: v1
kind: Service
metadata:
  name: mongodb
  namespace: aushadx
spec:
  clusterIP: None   # Headless – StatefulSet DNS: mongodb.aushadx.svc.cluster.local
  selector:
    app: mongodb
  ports:
    - port: 27017
      targetPort: 27017

---
# ════════════════════════════════════════════════════════════
# profile-manager (port 3001)
# ════════════════════════════════════════════════════════════
apiVersion: apps/v1
kind: Deployment
metadata:
  name: profile-manager
  namespace: aushadx
spec:
  replicas: 1
  selector:
    matchLabels:
      app: profile-manager
  template:
    metadata:
      labels:
        app: profile-manager
    spec:
      containers:
        - name: profile-manager
          image: aushadx/profile-manager:latest
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 3001
          env:
            - name: PORT
              value: "3001"
            - name: NODE_ENV
              value: "production"
            - name: MONGO_URI
              valueFrom:
                secretKeyRef:
                  name: aushadx-secrets
                  key: MONGO_URI
            - name: JWT_SECRET
              valueFrom:
                secretKeyRef:
                  name: aushadx-secrets
                  key: JWT_SECRET
            - name: JWT_ACCESS_SECRET
              valueFrom:
                secretKeyRef:
                  name: aushadx-secrets
                  key: JWT_ACCESS_SECRET
            - name: JWT_REFRESH_SECRET
              valueFrom:
                secretKeyRef:
                  name: aushadx-secrets
                  key: JWT_REFRESH_SECRET
            - name: JWT_ACCESS_EXPIRES_IN
              value: "15m"
            - name: JWT_REFRESH_EXPIRES_IN
              value: "7d"
          readinessProbe:
            httpGet:
              path: /health
              port: 3001
            initialDelaySeconds: 10
            periodSeconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: profile-manager
  namespace: aushadx
spec:
  type: ClusterIP   # internal only – reachable via DNS inside the cluster
  selector:
    app: profile-manager
  ports:
    - port: 3001
      targetPort: 3001

---
# ════════════════════════════════════════════════════════════
# medicine-analyzer (port 3002)
# ════════════════════════════════════════════════════════════
apiVersion: apps/v1
kind: Deployment
metadata:
  name: medicine-analyzer
  namespace: aushadx
spec:
  replicas: 1
  selector:
    matchLabels:
      app: medicine-analyzer
  template:
    metadata:
      labels:
        app: medicine-analyzer
    spec:
      containers:
        - name: medicine-analyzer
          image: aushadx/medicine-analyzer:latest
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 3002
          env:
            - name: PORT
              value: "3002"
            - name: NODE_ENV
              value: "production"
            - name: LLM_PROVIDER
              value: "gemini"
            - name: LLM_MODEL
              value: "gemini-2.0-flash"
            # ── profile-manager reference ──────────────────
            - name: PROFILE_SERVICE_HOST
              value: "profile-manager"
            - name: PROFILE_SERVICE_PORT
              value: "3001"
            - name: PROFILE_SERVICE_URL
              value: "http://$(PROFILE_SERVICE_HOST):$(PROFILE_SERVICE_PORT)"
            # ──────────────────────────────────────────────
            - name: PROPAGATE_AUTH
              value: "true"
            - name: GEMINI_API_KEY
              valueFrom:
                secretKeyRef:
                  name: aushadx-secrets
                  key: GEMINI_API_KEY
            - name: OPENAI_API_KEY
              valueFrom:
                secretKeyRef:
                  name: aushadx-secrets
                  key: OPENAI_API_KEY
            - name: PINECONE_API_KEY
              valueFrom:
                secretKeyRef:
                  name: aushadx-secrets
                  key: PINECONE_API_KEY
            - name: PINECONE_INDEX
              valueFrom:
                secretKeyRef:
                  name: aushadx-secrets
                  key: PINECONE_INDEX
            - name: PINECONE_INDEX_HOST
              valueFrom:
                secretKeyRef:
                  name: aushadx-secrets
                  key: PINECONE_INDEX_HOST
            - name: PINECONE_NAMESPACE
              valueFrom:
                secretKeyRef:
                  name: aushadx-secrets
                  key: PINECONE_NAMESPACE
---
apiVersion: v1
kind: Service
metadata:
  name: medicine-analyzer
  namespace: aushadx
spec:
  type: ClusterIP   # internal only – reachable via DNS inside the cluster
  selector:
    app: medicine-analyzer
  ports:
    - port: 3002
      targetPort: 3002

---
# ════════════════════════════════════════════════════════════
# medicine-scheduler (port 3003)
# ════════════════════════════════════════════════════════════
apiVersion: apps/v1
kind: Deployment
metadata:
  name: medicine-scheduler
  namespace: aushadx
spec:
  replicas: 1
  selector:
    matchLabels:
      app: medicine-scheduler
  template:
    metadata:
      labels:
        app: medicine-scheduler
    spec:
      containers:
        - name: medicine-scheduler
          image: aushadx/medicine-scheduler:latest
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 3003
          env:
            - name: PORT
              value: "3003"
            - name: NODE_ENV
              value: "production"
            - name: MONGO_URI
              valueFrom:
                secretKeyRef:
                  name: aushadx-secrets
                  key: MONGO_URI
---
apiVersion: v1
kind: Service
metadata:
  name: medicine-scheduler
  namespace: aushadx
spec:
  type: ClusterIP   # internal only – reachable via DNS inside the cluster
  selector:
    app: medicine-scheduler
  ports:
    - port: 3003
      targetPort: 3003

---
# ════════════════════════════════════════════════════════════
# agent-service (port 3004, Python)
# ════════════════════════════════════════════════════════════
apiVersion: apps/v1
kind: Deployment
metadata:
  name: agent-service
  namespace: aushadx
spec:
  replicas: 1
  selector:
    matchLabels:
      app: agent-service
  template:
    metadata:
      labels:
        app: agent-service
    spec:
      containers:
        - name: agent-service
          image: aushadx/agent-service:latest
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 3004
          env:
            - name: PORT
              value: "3004"
            # ── profile-manager reference ──────────────────
            - name: PROFILE_SERVICE_HOST
              value: "profile-manager"
            - name: PROFILE_SERVICE_PORT
              value: "3001"
            - name: PROFILE_SERVICE_URL
              value: "http://$(PROFILE_SERVICE_HOST):$(PROFILE_SERVICE_PORT)"
            # ──────────────────────────────────────────────
            - name: GEMINI_API_KEY
              valueFrom:
                secretKeyRef:
                  name: aushadx-secrets
                  key: GEMINI_API_KEY
---
apiVersion: v1
kind: Service
metadata:
  name: agent-service
  namespace: aushadx
spec:
  type: ClusterIP   # internal only – reachable via DNS inside the cluster
  selector:
    app: agent-service
  ports:
    - port: 3004
      targetPort: 3004

---
# ════════════════════════════════════════════════════════════
# api-server / API Gateway (port 3000) – NodePort for external access
# ════════════════════════════════════════════════════════════
apiVersion: apps/v1
kind: Deployment
metadata:
  name: api-server
  namespace: aushadx
spec:
  replicas: 1
  selector:
    matchLabels:
      app: api-server
  template:
    metadata:
      labels:
        app: api-server
    spec:
      containers:
        - name: api-server
          image: aushadx/api-server:latest
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 3000
          env:
            - name: PORT
              value: "3000"
            - name: NODE_ENV
              value: "production"
            # ── profile-manager ────────────────────────────
            - name: PROFILE_SERVICE_HOST
              value: "profile-manager"
            - name: PROFILE_SERVICE_PORT
              value: "3001"
            - name: PROFILE_SERVICE_URL
              value: "http://$(PROFILE_SERVICE_HOST):$(PROFILE_SERVICE_PORT)"
            - name: JWKS_URI
              value: "http://$(PROFILE_SERVICE_HOST):$(PROFILE_SERVICE_PORT)/.well-known/jwks.json"
            # ── medicine-scheduler ─────────────────────────
            - name: MEDICINE_SCHEDULER_HOST
              value: "medicine-scheduler"
            - name: MEDICINE_SCHEDULER_PORT
              value: "3003"
            - name: MEDICINE_SCHEDULER_URL
              value: "http://$(MEDICINE_SCHEDULER_HOST):$(MEDICINE_SCHEDULER_PORT)"
            # ── medicine-analyzer ──────────────────────────
            - name: MEDICINE_ANALYZER_HOST
              value: "medicine-analyzer"
            - name: MEDICINE_ANALYZER_PORT
              value: "3002"
            - name: MEDICINE_ANALYZER_URL
              value: "http://$(MEDICINE_ANALYZER_HOST):$(MEDICINE_ANALYZER_PORT)"
            # ── agent-service (WebSocket) ──────────────────
            - name: AGENT_SERVICE_HOST
              value: "agent-service"
            - name: AGENT_SERVICE_PORT
              value: "3004"
            - name: AGENT_SERVICE_URL
              value: "ws://$(AGENT_SERVICE_HOST):$(AGENT_SERVICE_PORT)"
          readinessProbe:
            httpGet:
              path: /health
              port: 3000
            initialDelaySeconds: 10
            periodSeconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: api-server
  namespace: aushadx
spec:
  type: NodePort
  selector:
    app: api-server
  ports:
    - port: 3000
      targetPort: 3000
      nodePort: 30000   # Access via: $(minikube ip):30000
