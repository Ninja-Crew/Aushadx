{
  "name": "medicine-analyzer",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "npm run test:unit && npm run test:component && npm run test:integration",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js test/unit/ --verbose",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js test/integration/ --verbose",
    "test:component": "node --experimental-vm-modules node_modules/jest/bin/jest.js test/component/ --verbose"
  },
  "dependencies": {
    "@google/genai": "^1.39.0",
    "@pinecone-database/pinecone": "^7.0.0",
    "express": "^4.18.2",
    "openai": "^4.104.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "dotenv": "^17.2.3",
    "jest": "^29.6.1",
    "nodemon": "^2.0.20",
    "supertest": "^6.3.3"
  }
}
