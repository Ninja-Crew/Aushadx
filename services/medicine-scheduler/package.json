{
  "name": "medicine-scheduler",
  "version": "1.0.0",
  "description": "Service for scheduling medicine reminders",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "worker": "node src/worker.js",
    "dev:worker": "nodemon src/worker.js",
    "test": "npm run test:unit && npm run test:component && npm run test:integration",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/unit/ --passWithNoTests",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/integration/ --passWithNoTests",
    "test:component": "cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/component/ --passWithNoTests"
  },
  "dependencies": {
    "agenda": "^5.0.0",
    "axios": "^1.13.6",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^13.7.0",
    "mongoose": "^7.4.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "jest": "^29.6.1",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  }
}
